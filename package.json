{
  "name": "nurse-scheduler",
  "version": "1.0.0",
  "description": "Professional TypeScript library for nursing shift scheduling – optimal MILP‑based engine",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --minify",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "nursing",
    "scheduling",
    "healthcare",
    "optimization",
    "milp"
  ],
  "author": "Danial Abdoli",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.7.0",
    "eslint": "^9.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "glpk.js": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
